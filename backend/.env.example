# =============================================
# SERVER CONFIGURATION
# =============================================
NODE_ENV=development
PORT=5000

# =============================================
# MONGODB CONFIGURATION
# =============================================
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mrd4mzt.mongodb.net/smart_disaster_db?retryWrites=true&w=majority

# =============================================
# NEO4J CONFIGURATION
# =============================================
# Format: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=neo4j+s://<your-db-id>.databases.neo4j.io
NEO4J_USERNAME=<your-username>
NEO4J_PASSWORD=<your-password>

# =============================================
# CORS CONFIGURATION
# =============================================
CORS_ORIGIN=http://localhost:3000

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

